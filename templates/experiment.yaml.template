# Minimal starting skeleton — matches plugin/schemas/experiment.schema.yaml,
# which documents commonly-used fields but only strictly requires
# id/slug/phase/source/repo. Add whatever else a given experiment needs
# (research/build/experiment/packaging/report/outputs/notes); the schema is
# permissive by design (2026-09-20 audit: a stricter version rejected every
# real record the facility had ever produced).
id: EXP-XXXX
slug: project-slug
phase: candidate
created: 1970-01-01T00:00:00Z
updated: 1970-01-01T00:00:00Z

source:
  surface: slack
  channel: "#development"
  message_ts: ""
  marked_by: ""
  marked_with: "🧪"
  url: https://example.invalid/owner/repo

repo:
  url: https://example.invalid/owner/repo
  owner: owner
  name: repo
  ref: null
  commit: null
  license: null

research: null
build: null
experiment: null
packaging: null
report: null

outputs:
  gist_url: null
  blog_status: draft

events_emitted: []
