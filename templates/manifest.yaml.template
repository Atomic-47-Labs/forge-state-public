facility: forge-state
version: 0.1
root: ~/forge

intake:
  surface: slack
  channels: ["#development"]
  marker: "🧪"
  markers_self_only: true

sandbox:
  runtime: docker
  base_images:
    node: node:20
    python: python:3.12
    go: golang:1.22
    rust: rust:1.79
    generic: ubuntu:24.04
  egress: registries-only
  cpu: 4
  memory: 8g
  per_repo_timeout_s: 1800
  night_budget_s: 14400

experiment:
  mode: hybrid

packaging:
  emit_bundle: true
  push_image: true
  # Must match the identity your `gh`/docker-login credentials actually
  # authenticate as — a mismatch here means pushes silently target an
  # account you can't write to. Confirm with `gh auth status` before relying
  # on this.
  registry: ghcr.io/CHANGE_ME

surfaces:
  gist: { enabled: true, auto: true }
  # `enabled` is the master switch — false skips scsiwyg entirely (no
  # blog_* output fields written, no scsiwyg calls made). `auto` only
  # matters when enabled is true: true publishes immediately, false drafts.
  blog: { enabled: true, target: scsiwyg, auto: true }
  work_state: { enabled: true }

durability:
  # Locked decision: github private mirror. Set the remote URL before relying on
  # the mirror — leave null until the user creates the private repo. Once set,
  # forge-orchestrator commits + pushes ~/forge to this remote at the end of
  # every walk (added 2026-09-20 — previously nothing synced this, ever).
  mirror:
    kind: github
    remote: null  # e.g. https://github.com/<you>/forge-mirror.git
    branch: main

secrets:
  store: sops-age
  refs: [anthropic, slack, github, scsiwyg, ghcr]
